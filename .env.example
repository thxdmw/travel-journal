SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=travel_journal
DB_USERNAME=travel_journal
DB_PASSWORD=change-me
DB_SSL_MODE=prefer
# 对象存储凭证只在这里配置。application.yml 里不再保留默认值，缺任何一项应用都会拒绝启动。
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=travel-journal
MINIO_PRESIGNED_URL_TTL_MINUTES=60
MINIO_VERIFY_ON_STARTUP=true
APP_ADMIN_USERNAME=admin
# 仅首次创建管理员时使用；生产环境必须填写至少 16 位的强密码，创建完成后可从配置中移除。
APP_ADMIN_PASSWORD=
APP_ADMIN_DISPLAY_NAME=旅行者
APP_BASE_URL=https://travel.example.com
# 季节主题按这个时区判断当前是春夏秋冬，填站点主人常驻的地方
APP_SITE_TIMEZONE=Asia/Shanghai
APP_UPLOAD_MAX_FILE_SIZE_MB=20
APP_UPLOAD_MAX_IMAGES_PER_JOURNAL=50
APP_UPLOAD_MAX_PIXELS=30000000
APP_MAP_PROVIDER=amap
APP_MAP_SEARCH_ENABLED=true
AMAP_WEB_SERVICE_KEY=
# 前台地图展示：AUTO（跟随访客网络地区）/ AMAP / OSM
APP_MAP_DISPLAY_PROVIDER=AUTO
# AUTO 判断不出访客地区时的兜底 Provider
APP_MAP_DISPLAY_FALLBACK=AMAP
# 高德「Web端(JS API)」Key，用于前台地图展示，去高德开放平台新建一个这个类型的 Key；
# 和上面的 AMAP_WEB_SERVICE_KEY 是两个不同的高德产品，不能混用。留空则前台只用 OSM。
AMAP_JS_KEY=
# 高德 JS API 安全密钥，只供服务端代理使用，严禁写进前端代码或公开仓库
AMAP_SECURITY_CODE=
# 默认由 Spring Boot 提供安全代理；若 Nginx 已按高德官方方式配置，可改为 /_AMapService
AMAP_SERVICE_HOST=/api/public/_AMapService
# Leaflet 使用的 OSM 兼容瓦片 Provider，可在不改代码的情况下替换
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_ATTRIBUTION=© OpenStreetMap contributors
# 反向代理注入的访客国家码 header 名，例如 CF-IPCountry；留空则 AUTO 直接用 APP_MAP_DISPLAY_FALLBACK
APP_MAP_GEO_HEADER=
# AI 整理随手记。留空表示不启用——整理照常可用，只是不润色文字。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
