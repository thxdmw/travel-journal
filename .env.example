SPRING_PROFILES_ACTIVE=prod
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_NAME=travel_journal
DB_USERNAME=travel_journal
DB_PASSWORD=change-me
DB_SSL_MODE=prefer
# 对象存储凭证只在这里配置。application.yml 里不再保留默认值，缺任何一项应用都会拒绝启动。
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=travel-journal
MINIO_PRESIGNED_URL_TTL_MINUTES=60
MINIO_VERIFY_ON_STARTUP=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-after-first-login
APP_ADMIN_DISPLAY_NAME=旅行者
APP_BASE_URL=https://travel.example.com
# 季节主题按这个时区判断当前是春夏秋冬，填站点主人常驻的地方
APP_SITE_TIMEZONE=Asia/Shanghai
APP_UPLOAD_MAX_FILE_SIZE_MB=20
APP_UPLOAD_MAX_IMAGES_PER_JOURNAL=50
APP_UPLOAD_MAX_PIXELS=50000000
APP_MAP_PROVIDER=amap
APP_MAP_SEARCH_ENABLED=true
AMAP_WEB_SERVICE_KEY=
# AI 整理随手记。留空表示不启用——整理照常可用，只是不润色文字。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
