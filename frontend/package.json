{
  "name": "travel-journal-frontend",
  "private": true,
  "type": "module",
  "description": "远行手记前端工程。Vite 负责公开站和管理后台的 TypeScript SFC 多页构建。",
  "scripts": {
    "dev": "vite",
    "build:dist": "vite build && node scripts/finalize-dist.mjs",
    "publish": "node scripts/publish-app.mjs",
    "build": "npm run build:dist && npm run publish",
    "verify:build": "node scripts/verify-app-build.mjs",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project=iphone-13",
    "e2e:report": "playwright show-report",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "axios": "1.7.9",
    "element-plus": "^2.11.1",
    "leaflet": "^1.9.4",
    "vue": "3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
