{
  "name": "travel-journal-frontend",
  "private": true,
  "type": "module",
  "description": "远行手记前端工程。Vite 负责公开站和管理后台的多页构建，页面层正在渐进迁移到 SFC。",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/publish-app.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "axios": "1.7.9",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
